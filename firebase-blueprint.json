{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized PJOK teacher administrator profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "School settings, core PJOK materials, semesters, and per-semester KKM configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schoolName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "teacherName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "teacherNip": { "type": "string", "maxLength": 64 },
        "schoolAddress": { "type": "string", "maxLength": 300 },
        "activeSemester": { "type": "string", "minLength": 1, "maxLength": 64 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "heroImageUrl": { "type": "string", "maxLength": 500 },
        "whatsappGatewayUrl": { "type": "string", "maxLength": 300 },
        "whatsappGatewayToken": { "type": "string", "maxLength": 300 },
        "socialLinks": { "type": "object" },
        "materials": { "type": "array" },
        "semesters": { "type": "array" },
        "semesterKkm": { "type": "object" },
        "classKkm": { "type": "object" },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "schoolName",
        "teacherName",
        "activeSemester",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "Full student record including parent WhatsApp PII (Admin-only access)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nis": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "className": { "type": "string", "minLength": 1, "maxLength": 32 },
        "gender": { "type": "string", "enum": ["L", "P"], "maxLength": 2 },
        "rfidUid": { "type": "string", "maxLength": 64 },
        "parentName": { "type": "string", "maxLength": 120 },
        "parentWhatsapp": { "type": "string", "maxLength": 32 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "qrCodeValue": { "type": "string", "maxLength": 200 },
        "qrImageUrl": { "type": "string", "maxLength": 500 },
        "primarySportInterest": { "type": "string", "maxLength": 80 },
        "nonAcademicActivity": { "type": "string", "maxLength": 120 },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nis",
        "name",
        "className",
        "gender",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "Grade": {
      "title": "Grade",
      "description": "Student PJOK core material assessment record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "semester": { "type": "string", "minLength": 1, "maxLength": 64 },
        "materialCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "materialName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "praktikScore": { "type": "number" },
        "pengetahuanScore": { "type": "number" },
        "teacherNote": { "type": "string", "maxLength": 500 },
        "remedialDetail": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentId",
        "semester",
        "materialCode",
        "materialName",
        "ownerUid",
        "createdAt",
        "serverUpdatedAt"
      ]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student attendance log (QR, RFID, NFC, or manual)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": { "type": "string", "maxLength": 16 },
        "time": { "type": "string", "maxLength": 16 },
        "status": {
          "type": "string",
          "enum": ["Hadir", "Terlambat", "Izin", "Sakit", "Alpa"],
          "maxLength": 24
        },
        "method": {
          "type": "string",
          "enum": ["QR_SCAN", "RFID_TAP", "NFC_TAP", "MANUAL"],
          "maxLength": 24
        },
        "whatsappNotified": { "type": "boolean" },
        "whatsappMessage": { "type": "string", "maxLength": 800 },
        "whatsappUrl": { "type": "string", "maxLength": 1200 },
        "notifiedAt": { "type": "string", "maxLength": 64 },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentId",
        "date",
        "time",
        "status",
        "method",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Grade or attendance notification record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetRole": { "type": "string", "maxLength": 24 },
        "type": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 800 },
        "isRead": { "type": "boolean" },
        "whatsappSent": { "type": "boolean" },
        "whatsappUrl": { "type": "string", "maxLength": 1200 },
        "clientCreatedAt": { "type": "string", "maxLength": 64 },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentId",
        "targetRole",
        "type",
        "title",
        "message",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Compressed image asset (student photo, QR image, or school logo) stored securely for cross-device access",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["photo", "qr", "logo", "hero"],
          "maxLength": 16
        },
        "mimeType": { "type": "string", "maxLength": 64 },
        "dataUrl": { "type": "string", "minLength": 10, "maxLength": 480000 },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "kind",
        "mimeType",
        "dataUrl",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicPortalDoc": {
      "title": "PublicPortalDoc",
      "description": "Non-PII aggregated public overview snapshot for cross-device public dashboard rendering",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "overview": { "type": "object" },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "overview", "ownerUid", "createdAt", "updatedAt"]
    },
    "StudentReport": {
      "title": "StudentReport",
      "description": "Non-PII hashed-NIS academic report snapshot allowing students to view their report cross-device via NIS",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payload": { "type": "object" },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentId",
        "payload",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin teacher registry"
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "School settings, core materials, semesters, and KKM"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Full student records including parent contact PII (Admin only)"
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/Grade" },
      "description": "Student grade records (Admin only)"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Student attendance records (Admin only)"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System notification records (Admin only)"
    },
    "/media_assets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Uploaded student photos, QR images, and school logo assets"
    },
    "/public_portal/{docId}": {
      "schema": { "$ref": "#/entities/PublicPortalDoc" },
      "description": "Aggregated non-PII public overview snapshots"
    },
    "/student_reports/{reportId}": {
      "schema": { "$ref": "#/entities/StudentReport" },
      "description": "Hashed-NIS non-PII student report cards for cross-device student access"
    }
  }
}
